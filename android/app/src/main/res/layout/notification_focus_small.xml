<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp">
        <Chronometer
            android:id="@+id/focus_chrono"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/focus_static"
            style="@android:style/TextAppearance.Material.Notification.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="28sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/focus_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FOCUS MODE"
            android:textColor="#E8A33D"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
        <TextView
            android:id="@+id/focus_task"
            style="@android:style/TextAppearance.Material.Notification.Line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />
        <TextView
            android:id="@+id/focus_sub"
            style="@android:style/TextAppearance.Material.Notification.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
